{
  "name": "llm-prices",
  "version": "1.1.0",
  "description": "Up-to-date LLM pricing reference and cost calculator — Claude, GPT, Gemini, Grok, Mistral, DeepSeek, Groq and more. Long-context tiers, SDK usage objects, spend tracking. Zero dependencies, library + CLI.",
  "keywords": [
    "llm",
    "pricing",
    "prices",
    "cost",
    "calculator",
    "tokens",
    "token-cost",
    "api-cost",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "gemini",
    "grok",
    "deepseek",
    "mistral",
    "groq",
    "perplexity",
    "cohere",
    "ai",
    "llmops",
    "finops",
    "cli"
  ],
  "license": "MIT",
  "author": "Cryptoteep",
  "homepage": "https://github.com/Cryptoteep/llm-prices#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cryptoteep/llm-prices.git"
  },
  "bugs": {
    "url": "https://github.com/Cryptoteep/llm-prices/issues"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./data": "./data/prices.json"
  },
  "bin": {
    "llm-prices": "bin/cli.js"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "bin/",
    "data/",
    "scripts/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.cjs\"",
    "update-prices": "node scripts/update.mjs",
    "check-prices": "node scripts/update.mjs --check"
  },
  "engines": {
    "node": ">=18"
  }
}
